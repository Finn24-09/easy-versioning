{
  "name": "easy-versioning",
  "version": "1.2.1",
  "private": true,
  "description": "Auto-bump npm package versions on PR merge using Calendar Versioning",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "test": "jest --passWithNoTests --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "all": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "js-yaml": "^5.4.3",
    "minimatch": "^11.0.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
